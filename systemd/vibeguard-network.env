# Root-owned gateway settings for managed wg-quick units.
# auto selects the default-route uplink (per family, falling back to the other).
VIBEGUARD_EGRESS_INTERFACE=auto
VIBEGUARD_MANAGE_FIREWALL=1
VIBEGUARD_NAT=1
# Set to 1 for IPv6 masquerading; leave 0 for upstream-routed IPv6 prefixes.
VIBEGUARD_NAT66=0
