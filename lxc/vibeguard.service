[Unit]
Description=VibeGuard WireGuard management UI
Wants=network-online.target
After=network-online.target

[Service]
# Runs as root: VIBEGUARD_WG_QUICK_BOOT needs `systemctl enable wg-quick@<name>` and
# writes to /etc/wireguard. `make install` can override User= via VIBEGUARD_USER.
User=root
EnvironmentFile=/etc/vibeguard.env
Environment=VIBEGUARD_WG_DIR=/etc/wireguard
ExecStart=/usr/local/bin/vibeguard
Restart=on-failure
# Keeps the state directory (data.json) private to the service.
StateDirectory=vibeguard
StateDirectoryMode=0700
# No capability bounding and no NoNewPrivileges, so systemctl can be run.

[Install]
WantedBy=multi-user.target
